ZMK_BASE_LAYER(Alpha1,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           SMART_NUM           MAGIC_SHIFT ___           ___         ,   ___            &kp BSPC      MAGIC_SHIFT           ___           ___         ,
