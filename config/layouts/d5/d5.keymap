      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR
#else
  #define _BT_SEL_KEYS_ &trans &trans &trans &trans &trans
#endif

#include "zmk-helpers/helper.h"


#define DEF 0
#define NAV  1
#define NUM  2
#define SYS  3

#define XXX &none
#define ___ &trans

#ifndef ZMK_BASE_LAYER
  #define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                 \
      ZMK_LAYER(name, LT RT LM RM LB RB LH RH)
#endif

#include "zmk-helpers/helper.h"
#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50
#define XXX &none
#define ___ &trans


ZMK_COMBO(eg,  &kp E &kp G,     LTR LMR,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(ew,  &kp E &kp W,     LMR LBR,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(ct,  &kp C &kp T,     LTM LMM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(tc,  &kp T &kp C,     LMM LBM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rm,  &kp R &kp M,     LTI LMI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rk,  &kp R &kp K,     LMI LBI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(yv,  &kp Y &kp V,     LTC LMC,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(je, &kp J &kp E,     RTR RMR,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(es, &kp E &kp S,     RMR RBR,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(nf, &kp N &kp F,     RTM RMM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(np, &kp N &kp P,     RMM RBM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(bl, &kp B &kp L,     RTI RMI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(hl, &kp H &kp L,     RMI RBI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(q , &kp Q      ,     RTC RMC,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(ui, &kp U &kp I,     LBR LTR,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(oa, &kp O &kp A,     LMR LTM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(o, &kp O      ,     LMR LMM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(a, &kp A      ,     LMM LMI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(u, &kp U      ,     RMR RMM,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(i, &kp I      ,     RMM RMI,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)


ZMK_BASE_LAYER(DEF,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           &kp G         &kp D         &kp M         &kp Y       ,   &kp Y        &kp B         &kp F         &kp J         ___          ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp SPC       &kp E         &kp T         &kp R         &kp V       ,   &kp Z        &kp L         &kp N         &kp E         &kp SPC      ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp TAB       &kp W         &kp C         &kp K         &kp BSPC    ,   &kp BSPC     &kp H         &kp P         &kp S         &kp ENTER    ,
//╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴───────────────────────────╯
                                              &kp U         &kp I       ,   &kp A    &kp O
//                                          ╰─────────────┴─────────────╯ ╰─────────────┴─────────────╯
)



